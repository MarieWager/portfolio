---
const { elem1, elem2, elem3 } = Astro.props;
---

<header>
  <section></section>
  <main class="search_bar">
    <div class="search_icon">
      <img src="/media/search_icon.svg" alt="" />
    </div>
    <nav class="nav">
      <ul>
        <li><h3><a href=`#${elem1}` aria-label=`Go to ${elem1}`>{elem1}</a></h3></li>
        <li><h3><a href=`#${elem2}` aria-label=`Go to ${elem2}`>{elem2}</a></h3></li>
        <li><h3><a href=`#${elem3}` aria-label=`Go to ${elem3}`>{elem3}</a></h3></li>
      </ul>
    </nav>
  </main>
</header>

<style>
  /** mobile **/
  h3 {
    margin: 0;
  }

  header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 3000;
    transition: opacity 0.3s ease;
    opacity: 5;
    background-color: #fff5e7d3;
    background: var(--oldlace);
    margin-bottom: 0;
  }

  header.scrolled {
    opacity: 0.95;
  }

  .search_bar {
    background-color: var(--snow);
    border-radius: 20px;
    border: var(--border-1);
    box-shadow: var(--shadow-drop);
    right: 0;
    margin: 3vw 5vw 0 5vw;
    display: grid;
    grid-template-columns: 1fr 5fr;
    max-height: 45wv;
  }

  .search_icon {
    background-color: var(--lightpurple);
    border-radius: 18px 0px 0px 18px;
    border-right: var(--border-1);
    display: grid;
    align-content: center;
    justify-content: center;
    width: clamp(45px, 12vw, 75px);
    max-height: 75px;
    img {
      transform: scale(90%, 90%);
      padding: 1vw;
    }
  }

  nav {
    align-self: center;
    ul {
      font-size: var(--h3);
      padding: 0;
      display: flex;
      justify-content: space-evenly;
    }
  }

  /** desktop **/

  @media (min-width: 860px) {
    .search_bar {
      grid-template-columns: 1fr 14fr;
    }
    .nav {
      padding-right: 8vw;

      ul {
        font-size: var(--h3);
        align-content: center;
      }
    }
  }
</style>
