---
import KontaktInfoCard from "../components/KontaktInfoCard.astro";
import ProfilCard from "../components/ProfilCard.astro";
import KompetanceCard from "../components/KompetanceCard.astro";
import DescCard from "../components/DescCard.astro";
---

<article>
  <div id="space"><h1>Jeres nye praktikant?</h1></div>
  <section>
      <KontaktInfoCard sted="Name" variant="gul" kontakt="Marie Jensen" link="none" />
      <figure>
        <img src="/media/ani_transparent.gif" loading="lazy" alt="motion graphic" />
      </figure>
      <ProfilCard />
      <DescCard />
      <KompetanceCard />
  </section>

</article>

<style>
    /** mobile **/
    h1 {
      justify-self: center;
    }

article {
  margin-top: 2rem;

  display: grid;
  grid-template-columns: 1fr;

  section {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(4, auto);
    gap: 1rem;
    height: fit-content;

    /* elementernes placeringer - mobil */
    & > *:nth-child(1) { grid-area: 1 / 1 / 2 / 4; } /*navn*/
    & > *:nth-child(2) { grid-area: 1 / 4 / 2 / 5; } /*img*/
    & > *:nth-child(3) { grid-area: 2 / 1 / 3 / 5; } /*profile*/
    & > *:nth-child(4) { grid-area: 3 / 1 / 4 / 5; } /*desc*/
    & > *:nth-child(5) { grid-area: 4 / 1 / 5 / 5; } /*kompetencer*/

    @media (min-width: 700px) {
      gap: 2.5vw;

      /* elementernes placeringer - tablet */
       & > *:nth-child(1) { grid-area: 1 / 1 / 2 / 4; }
       & > *:nth-child(2) { grid-area: 1 / 4 / 3 / 5; }
       & > *:nth-child(3) { grid-area: 3 / 1 / 5 / 3; }
       & > *:nth-child(4) { grid-area: 2 / 1 / 3 / 4; }
       & > *:nth-child(5) { grid-area: 3 / 3 / 5 / 5; }
    }

    @media (min-width: 1100px) {
      grid-template-columns: repeat(6, 1fr);
      grid-template-rows: auto 1fr auto;

      /* elementernes placeringer - desk */
      & > *:nth-child(1) { grid-area: 1 / 1 / 2 / 3; height: max-content;}
      & > *:nth-child(2) { grid-area: 1 / 3 / 4 / 5; min-width: 350px; max-width: 500px;}
      & > *:nth-child(3) { grid-area: 2 / 1 / 4 / 3; }
      & > *:nth-child(4) { grid-area: 3 / 5 / 4 / 7; height: max-content; align-self: end;}
      & > *:nth-child(5) { grid-area: 1 / 5 / 3 / 7; }
    }
  }
}


  figure {
      display: grid;
      place-items: center
      object-fit: cover;
      overflow: hidden;
      width: 100%;
      min-width: 90px;
      min-height: 90px;
      height: 100%;
      aspect-ratio: 1 / 1;

      border-radius: 20px;
      background-color: var(--snow);
      box-shadow: var(--shadow-drop);
      outline: var(--border-1);
      img {
        background-color: var(--snow);
        border-radius: var(--br-12);
        width: 100%;
        height: 100%;
        object-fit: cover;
        transform: scale(150%, 150%) translateY(5.3%);
      }
       
  }

  </style>

