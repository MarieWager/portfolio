---
import KontaktInfoCard from "../components/KontaktInfoCard.astro";
import ProfilCard from "../components/ProfilCard.astro";
import GifCard from "../components/GifCard.astro";
import KompetanceCard from "../components/KompetanceCard.astro";
import DescCard from "../components/DescCard.astro";
---

<article>
  <div id="space"><h1>Jeres nye praktikant?</h1></div>
  <div class="wrap">
    <div class="bento">
      <div class="box">
        <KontaktInfoCard sted="Name" variant="gul" kontakt="Marie Jensen" />
        <figure>
          <img class="mobile" src="/media/ani_transparent.gif" loading="lazy" alt="" />
        </figure>
      </div>
      <ProfilCard />
      <div class="mobile">
        <DescCard />
      </div>
    </div>

    <figure>
      <img class="desk" src="/media/ani_transparent.gif" loading="lazy" alt="motion graphic" />
    </figure>

    <div class="bento">
      <KompetanceCard />

      <div class="desk">
        <DescCard />
      </div>
    </div>
  </div>

  <style>
    /** mobile **/
    .desk {
      display: none;
    }
    .mobile {
      display: block;
    }
    .wrap,
    .bento {
      display: flex;
      flex-direction: column;
      gap: 2rem;
      object-fit: contain;
    }
    .box {
      display: grid;
      grid-template-columns: 9fr 1fr;
      gap: 1rem;
      figure {
        display: grid;
        place-items: center
        object-fit: cover;
        overflow: hidden;
        width: 100%;
        min-width: 90px;
        min-height: 90px;
        height: 100%;
        aspect-ratio: 1 / 1;

        border-radius: 20px;
        background-color: var(--snow);
        box-shadow: var(--shadow-drop);
        outline: var(--border-1);
        img.mobile {
          background-color: var(--snow);
          border-radius: var(--br-12);
          width: 100%;
          height: 100%;
          object-fit: cover;
          transform: scale(150%, 150%) translateY(5px);
        }
      }
    }

    article {
      display: grid;
      grid-template-columns: 1fr;
    }
    h1 {
      justify-self: center;
    }

    @media (min-width: 860px) {
      /** desktop **/
      .mobile {
        display: none;
      }
      .desk {
        display: block;
      }

      img.desk {
        justify-self: center;

        background-color: var(--oldlace);
        border-radius: var(--br-12);
        border: var(--border-1);
        padding-top: 5vh;
        width: clamp(160px, 100%, 305px);
      }

      .box {
        display: unset;
      }
      .wrap {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
      }
    }
  </style>
</article>
