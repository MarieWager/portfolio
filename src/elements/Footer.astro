---
import KontaktInfoCard from "../components/KontaktInfoCard.astro";
---

<article>
  
  <section>
    <h1>Kontakt mig her</h1>

    <figure>
      <img src="/media/portrait-transparent.png" loading="lazy" alt="Portrait" />
    </figure>

    <KontaktInfoCard sted="Email" variant="gul" ani="true" link="mailto:mariewpj@gmail.com" kontakt="Mariewpj@gmail.com" />
    <KontaktInfoCard sted="Telefonnummer" variant="lys" ani="true" link="tel:+4529176648" kontakt="29 17 66 48" />
    <KontaktInfoCard sted="LinkedIn" variant="lilla" ani="true" link="https://www.linkedin.com/in/marie-jensen-031603222/" kontakt="in/marie-jensen-031603222/" />
  </section>

</article>

<style>
  article {
    display: grid;
    grid-template-columns: 1fr;
    justify-content: center;

    section {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      grid-template-rows: repeat(4, auto);
      gap: 1rem;
      height: fit-content;
      width: fit-content;

      /* elementernes placeringer - mobil */
      & > *:nth-child(1) {
        grid-area: 1 / 1 / 2 / 4;
        align-self: end;
      } /*h1*/
      & > *:nth-child(2) {
        grid-area: 1 / 4 / 2 / 5;
        place-self: end;
        aspect-ratio: 1 / 1;
      } /*img*/
      & > *:nth-child(3) {
        grid-area: 2 / 1 / 3 / 5;
      } /*email*/
      & > *:nth-child(4) {
        grid-area: 3 / 1 / 4 / 5;
      } /*tlf*/
      & > *:nth-child(5) {
        grid-area: 4 / 1 / 5 / 5;
      } /*Linked*/

      @media (min-width: 550px) {
       grid-template-columns: repeat(auto-fit, minmax(90px, 1fr));

        /* elementernes placeringer - tablet */
        & > *:nth-child(1) {
          grid-area: 1 / 1 / 2 / 5;
          text-align: center;
        }
        & > *:nth-child(2) {
          grid-area: 2 / 1 / 5 / 3;
        }
        & > *:nth-child(3) {
          grid-area: 2 / 3 / 3 / 5;
        }
        & > *:nth-child(4) {
          grid-area: 3 / 3 / 4 / 5;
        }
        & > *:nth-child(5) {
          grid-area: 4 / 3 / 5 / 5;
        }
      }

      @media (min-width: 700px) {   
        gap: 2.5vw; 
       
        /* elementernes placeringer - tablet */
        & > *:nth-child(1) {
          grid-area: 1 / 1 / 2 / 7;
          text-align: center;
        }
        & > *:nth-child(2) {
          grid-area: 2 / 1 / 5 / 3;
        }
        & > *:nth-child(3) {
          grid-area: 2 / 3 / 3 / 7;
        }
        & > *:nth-child(4) {
          grid-area: 3 / 3 / 4 / 7;
        }
        & > *:nth-child(5) {
          grid-area: 4 / 3 / 5 / 7;
        }
      }
 
    }
  }

  figure {
      display: grid;
      place-items: center
      object-fit: cover;
      overflow: hidden;
      width: 100%;
      min-width: 90px;
      min-height: 90px;
      height: 100%;
      aspect-ratio: 1 / 1;

      border-radius: 20px;
      background-color: var(--snow);
      box-shadow: var(--shadow-drop);
      outline: var(--border-1);
    
    img {
      width: 100%;
      min-width: 90px;
      min-height: 90px;
      height: 100%;
      overflow: hidden;
      object-fit: cover;
      border-radius: 20px;
      background-color: var(--snow);
      transform: scale(150%, 150%) translateY(-3%);
       @media (min-width: 550px) {   
        transform: 
        scale(130%, 130%) 
        translateY(-3%) 
        translateX(-2.5%);
        }
    }
  }
  
</style>
